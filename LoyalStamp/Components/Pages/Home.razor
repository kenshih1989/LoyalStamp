@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Home - LoyalStamp</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-8 col-lg-6">
            <h1 class="display-5 fw-bold mb-3">LoyalStamp</h1>
            <p class="lead text-muted mb-4">
                Digital loyalty stamp cards made simple for customers and local merchants.
            </p>

            <AuthorizeView>
                <NotAuthorized>
                    <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                        <a href="/register-as-merchant" class="btn btn-primary btn-lg px-4">
                            Register as Merchant
                        </a>
                        <a href="/register-as-user" class="btn btn-outline-primary btn-lg px-4">
                            Register as Customer
                        </a>
                        <a href="/login" class="btn btn-dark btn-lg px-4">
                            Login
                        </a>
                    </div>
                </NotAuthorized>
                <Authorized Context="authState">
                    @{
                        var displayName = authState.User.FindFirst("FullName")?.Value
                                          ?? authState.User.Identity?.Name;
                    }
                    <div class="alert alert-light border shadow-sm mb-4">
                        Welcome back, <strong>@displayName</strong>!
                    </div>

                    <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                        @if (authState.User.IsInRole("Merchant"))
                        {
                            <a href="/merchant/dashboard" class="btn btn-primary btn-lg px-4">
                                Go to Merchant Dashboard
                            </a>
                        }
                        else
                        {
                            <a href="/explore" class="btn btn-primary btn-lg px-4">
                                Explore Stamp Cards
                            </a>
                        }
                        <form action="/logout" method="post">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-outline-danger btn-lg px-4">
                                Logout
                            </button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>

            @* 后续扩展区：可在下方逐步添加 Active Campaigns 预览、平台介绍卡片或统计数据 *@
            @* Additional expansion area: You can gradually add previews of active campaigns, platform introduction cards, or statistical data below. *@
        </div>
    </div>
</div>