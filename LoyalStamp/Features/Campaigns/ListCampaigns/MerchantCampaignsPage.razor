@page "/merchant/campaigns"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Merchant")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject ListCampaignsQuery Query

<PageTitle>My Campaigns - LoyalStamp</PageTitle>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Stamp Campaigns</h2>
            @if (!string.IsNullOrEmpty(_storeName))
            {
                <p class="text-muted mb-0">Store: <strong>@_storeName</strong></p>
            }
        </div>
        <a href="/merchant/campaigns/create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Create New Campaign
        </a>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Loading your campaigns...</p>
        </div>
    }
    else if (!_campaigns.Any())
    {
        <div class="card shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-card-checklist display-4 text-muted mb-3"></i>
                <h5>No Stamp Campaigns Yet</h5>
                <p class="text-muted">Launch your first loyalty stamp card to start rewarding repeat customers.</p>
                <a href="/merchant/campaigns/create" class="btn btn-primary">Create Your First Campaign</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var campaign in _campaigns)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm @(campaign.IsActive ? "border-primary" : "border-secondary opacity-75")">
                        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                            <span class="badge @(campaign.IsActive ? "bg-success" : "bg-secondary")">
                                @(campaign.IsActive ? "Active" : "Inactive")
                            </span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       checked="@campaign.IsActive"
                                       @onchange="@(() => ToggleCampaignStatusAsync(campaign.Id))"
                                       title="Toggle campaign visibility" />
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-3">@campaign.Title</h5>
                            <ul class="list-unstyled small mb-0">
                                <li class="mb-2">
                                    <i class="bi bi-cash-coin text-primary me-2"></i>
                                    <strong>Min Spend:</strong> $@campaign.MinSpendAmount.ToString("F2") / stamp
                                </li>
                                <li class="mb-2">
                                    <i class="bi bi-grid-3x3-gap text-primary me-2"></i>
                                    <strong>Target:</strong> @campaign.TargetStamps stamps
                                </li>
                                <li>
                                    <i class="bi bi-gift text-success me-2"></i>
                                    <strong>Reward:</strong> @campaign.RewardItem
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                            <small class="text-muted">Created @campaign.CreatedAt.ToString("MMM dd, yyyy")</small>
                            <a href="/merchant/campaigns/edit/@campaign.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil-square me-1"></i> Edit
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string _storeName = string.Empty;
    private List<CampaignSummaryDto> _campaigns = new();
    private string? _currentUserId;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            _currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        }

        if (!string.IsNullOrEmpty(_currentUserId))
        {
            await LoadCampaignsAsync();
        }
        _isLoading = false;
    }

    private async Task LoadCampaignsAsync()
    {
        if (string.IsNullOrEmpty(_currentUserId)) return;
        var result = await Query.ExecuteAsync(_currentUserId);
        _storeName = result.StoreName;
        _campaigns = result.Campaigns;
    }

    private async Task ToggleCampaignStatusAsync(int campaignId)
    {
        if (string.IsNullOrEmpty(_currentUserId)) return;

        var updated = await Query.ToggleStatusAsync(campaignId, _currentUserId);
        if (updated)
        {
            await LoadCampaignsAsync();
        }
    }
}