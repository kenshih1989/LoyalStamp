@page "/merchant/campaigns/create"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Merchant")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject CreateCampaignHandler Handler
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Create Campaign - LoyalStamp</PageTitle>

<div class="container my-4" style="max-width: 600px;">
    <div class="mb-3">
        <a href="/merchant/campaigns" class="text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Back to My Campaigns
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h3 class="card-title mb-1">Create New Stamp Campaign</h3>
            <p class="text-muted small mb-4">Define how customers earn stamps and what reward they unlock.</p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger">@_errorMessage</div>
            }

            <EditForm Model="_request" OnValidSubmit="HandleSubmitAsync" FormName="CreateCampaignForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Campaign Title <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="_request.Title" placeholder="e.g., Coffee Lover Card" />
                    <ValidationMessage For="@(() => _request.Title)" class="text-danger small" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Min Spend per Stamp ($) <span class="text-danger">*</span></label>
                        <InputNumber class="form-control" @bind-Value="_request.MinSpendAmount" step="0.50" />
                        <ValidationMessage For="@(() => _request.MinSpendAmount)" class="text-danger small" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Target Stamps for Reward <span class="text-danger">*</span></label>
                        <InputNumber class="form-control" @bind-Value="_request.TargetStamps" />
                        <ValidationMessage For="@(() => _request.TargetStamps)" class="text-danger small" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Free Reward Item <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="_request.RewardItem" placeholder="e.g., 1 Free Artisan Latte" />
                    <ValidationMessage For="@(() => _request.RewardItem)" class="text-danger small" />
                </div>

                <div class="alert alert-light border small mb-3">
                    <strong>Rule Preview:</strong> Customers earn 1 stamp for every
                    <strong>$@_request.MinSpendAmount.ToString("F2")</strong> spent. Collect
                    <strong>@_request.TargetStamps</strong> stamps to redeem
                    <strong>@(string.IsNullOrWhiteSpace(_request.RewardItem) ? "their free reward" : _request.RewardItem)</strong>.
                </div>

                <div class="form-check form-switch mb-4">
                    <InputCheckbox class="form-check-input" @bind-Value="_request.IsActive" id="isActiveSwitch" />
                    <label class="form-check-label" for="isActiveSwitch">
                        Publish immediately (Visible to customers in Explore)
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Launch Campaign</span>
                        }
                    </button>
                    <a href="/merchant/campaigns" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private CreateCampaignRequest _request = new();
    private string? _errorMessage;
    private bool _isSubmitting = false;

    private async Task HandleSubmitAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var authState = AuthenticationStateTask is not null
                ? await AuthenticationStateTask
                : null;
            var userId = authState?.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrEmpty(userId))
            {
                _errorMessage = "Unable to verify merchant identity. Please log in again.";
                return;
            }

            var (succeeded, error) = await Handler.HandleAsync(_request, userId);
            if (succeeded)
            {
                Navigation.NavigateTo("/merchant/campaigns");
            }
            else
            {
                _errorMessage = error;
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}