@page "/my-wallet"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Customer")]
@implements IAsyncDisposable
@using System.Net
@using System.Security.Claims
@using LoyalStamp.Features.CustomerWallet.MyCards
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@inject MyCardsQuery Query
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>My Stamp Cards - LoyalStamp</PageTitle>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Stamp Cards</h2>
            <p class="text-muted mb-0">Tap any card to show your checkout QR code.</p>
        </div>
        <a href="/explore" class="btn btn-primary">
            <i class="bi bi-compass me-1"></i> Explore More
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_liveToastMessage))
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-lightning-charge-fill text-warning me-2"></i>
            <strong>Live Update:</strong> @_liveToastMessage
            <button type="button" class="btn-close" @onclick="() => _liveToastMessage = null"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Loading your wallet...</p>
        </div>
    }
    else if (!_cards.Any())
    {
        <div class="card shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-wallet2 display-4 text-muted mb-3"></i>
                <h5>Your Wallet is Empty</h5>
                <p class="text-muted">Browse active campaigns from local stores and join your first stamp card.</p>
                <a href="/explore" class="btn btn-primary">Explore Campaigns</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var card in _cards)
            {
                var isReadyToRedeem = card.CurrentStamps >= card.TargetStamps;
                var totalSlots = Math.Max(card.TargetStamps, card.CurrentStamps);

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm @(isReadyToRedeem ? "border-success border-2" : "")"
                         style="cursor: pointer;"
                         @onclick="() => _selectedCard = card">
                        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(card.LogoUrl))
                                {
                                    <img src="@card.LogoUrl" alt="@card.StoreName"
                                         class="rounded-circle border" style="width: 32px; height: 32px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold small"
                                         style="width: 32px; height: 32px;">
                                        @card.StoreName.Substring(0, 1).ToUpper()
                                    </div>
                                }
                                <span class="fw-bold">@card.StoreName</span>
                            </div>

                            @if (isReadyToRedeem)
                            {
                                <span class="badge bg-success">Reward Ready!</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">@card.CurrentStamps / @card.TargetStamps</span>
                            }
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-1">@card.CampaignTitle</h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-gift text-success me-1"></i> @card.RewardItem
                            </p>

                            <!-- Visual stamp grid -->
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @for (int i = 1; i <= totalSlots; i++)
                                {
                                    bool isStamped = i <= card.CurrentStamps;
                                    bool isOverflow = i > card.TargetStamps;

                                    <div class="rounded-circle d-flex align-items-center justify-content-center border @(isStamped ? (isOverflow ? "bg-warning text-dark border-warning" : "bg-primary text-white border-primary") : "bg-light text-muted")"
                                         style="width: 34px; height: 34px; font-size: 0.85rem;"
                                         title="@(isOverflow ? "Carryover stamp" : $"Stamp {i}")">
                                        @if (isStamped)
                                        {
                                            <i class="bi bi-patch-check-fill"></i>
                                        }
                                        else
                                        {
                                            <span>@i</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                            <small class="text-muted font-monospace">@card.CardCode</small>
                            <span class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-qr-code me-1"></i> Show QR
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<CardQrModal Card="_selectedCard" OnClose="() => _selectedCard = null" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<CustomerCardDto> _cards = new();
    private CustomerCardDto? _selectedCard;
    private string? _userId;
    private string? _liveToastMessage;
    private bool _isLoading = true;
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            _userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (!string.IsNullOrEmpty(_userId))
            {
                _cards = await Query.ExecuteAsync(_userId);
                await InitializeSignalRAsync();
            }
        }

        _isLoading = false;
    }

    private async Task InitializeSignalRAsync()
    {
        // Forward authentication cookies so the SignalR Hub can identify the logged-in customer
        var cookieHeader = HttpContextAccessor.HttpContext?.Request.Headers.Cookie.ToString();
        var hubUrl = Navigation.ToAbsoluteUri("/hubs/stamps");

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl, options =>
            {
                if (!string.IsNullOrEmpty(cookieHeader))
                {
                    options.Cookies = new CookieContainer();
                    options.Headers.Add("Cookie", cookieHeader);
                }
            })
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<Guid, string>("ReceiveStampUpdate", async (updatedCardId, message) =>
        {
            if (string.IsNullOrEmpty(_userId)) return;

            _cards = await Query.ExecuteAsync(_userId);
            _liveToastMessage = message;

            // Keep the open QR modal synchronized if the customer is currently displaying that card
            if (_selectedCard is not null && _selectedCard.CardId == updatedCardId)
            {
                _selectedCard = _cards.FirstOrDefault(c => c.CardId == updatedCardId);
            }

            await InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}