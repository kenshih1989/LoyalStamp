@page "/merchant/issue-stamp"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Merchant")]
@using System.Security.Claims
@using LoyalStamp.Features.StampOperations.RedeemReward
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IssueStampCommand IssueCommand
@inject RedeemRewardCommand RedeemCommand

<PageTitle>Issue Stamps & Redeem - LoyalStamp</PageTitle>

<div class="container my-4" style="max-width: 820px;">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Checkout Terminal: Issue & Redeem</h2>
        <p class="text-muted mb-0">Scan a customer's QR code or enter their fallback card code to issue stamps or redeem rewards.</p>
    </div>

    <!-- Step 1: Lookup Customer Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-transparent fw-bold">
            <i class="bi bi-qr-code-scan text-primary me-2"></i> Step 1: Scan or Enter Customer Card Code
        </div>
        <div class="card-body">
            <div class="input-group input-group-lg">
                <input type="text"
                       class="form-control font-monospace"
                       placeholder="Scan QR GUID or enter short code (e.g., LS-8A92B)"
                       @bind="_codeInput"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDownAsync" />
                <button class="btn btn-primary px-4"
                        disabled="@_isLookingUp"
                        @onclick="LookupCardAsync">
                    @if (_isLookingUp)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <span>Find Card</span>
                </button>
                @if (_scannedCard is not null || !string.IsNullOrEmpty(_codeInput))
                {
                    <button class="btn btn-outline-secondary" @onclick="ResetTerminal">
                        Clear
                    </button>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi @(_isError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
            @_statusMessage
            <button type="button" class="btn-close" @onclick="() => _statusMessage = null"></button>
        </div>
    }

    @if (_scannedCard is not null)
    {
        var isEligibleToRedeem = _scannedCard.CurrentStamps >= _scannedCard.TargetStamps;
        var previewEarned = _spendAmount > 0
            ? (int)Math.Floor(Math.Round(_spendAmount, 2) / _scannedCard.MinSpendAmount)
            : 0;

        <!-- Step 2: Customer Card Summary -->
        <div class="card shadow-sm mb-4 @(isEligibleToRedeem ? "border-success border-2" : "border-primary")">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-bold fs-5">@_scannedCard.CustomerName</span>
                    <span class="text-muted small ms-2">(@_scannedCard.CustomerEmail)</span>
                </div>
                <span class="badge bg-dark font-monospace fs-6">@_scannedCard.CardCode</span>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-7">
                        <h5 class="fw-bold text-primary mb-1">@_scannedCard.CampaignTitle</h5>
                        <p class="small text-muted mb-2">
                            Rule: Spend <strong>$@_scannedCard.MinSpendAmount.ToString("F2")</strong> = 1 Stamp •
                            Goal: <strong>@_scannedCard.TargetStamps Stamps</strong>
                        </p>
                        <div class="small">
                            <i class="bi bi-gift-fill text-success me-1"></i>
                            <strong>Reward:</strong> @_scannedCard.RewardItem
                        </div>
                    </div>
                    <div class="col-md-5 text-md-end">
                        <div class="text-muted small text-uppercase fw-semibold">Current Balance</div>
                        <div class="display-6 fw-bold @(isEligibleToRedeem ? "text-success" : "text-dark")">
                            @_scannedCard.CurrentStamps <span class="fs-5 text-muted">/ @_scannedCard.TargetStamps</span>
                        </div>
                        <small class="text-muted">Total Redeemed: @_scannedCard.TotalRedeemedCount time(s)</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 3: Issue Stamps & Redeem Reward Actions -->
        <div class="row g-4">
            <!-- Left Card: Issue Stamps -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white fw-bold">
                        <i class="bi bi-patch-plus me-1"></i> Issue Stamps
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Customer Spend Amount ($)</label>
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control form-control-lg"
                                   @bind="_spendAmount"
                                   @bind:event="oninput" />
                            <div class="form-text">
                                Preview: <strong>@previewEarned stamp(s)</strong> will be issued
                                (Min $@_scannedCard.MinSpendAmount.ToString("F2") / stamp).
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted">Receipt / Order Note (Optional)</label>
                            <input type="text"
                                   class="form-control"
                                   maxlength="200"
                                   placeholder="e.g., Receipt #1042"
                                   @bind="_earnNotes" />
                        </div>

                        <button class="btn btn-primary w-100 mt-auto"
                                disabled="@(_isProcessing || !_scannedCard.IsCampaignActive)"
                                @onclick="HandleIssueStampsAsync">
                            @if (_isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <span>Issue @previewEarned Stamp(s)</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Card: Redeem Reward -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100 @(isEligibleToRedeem ? "border-success" : "")">
                    <div class="card-header @(isEligibleToRedeem ? "bg-success text-white" : "bg-light text-muted") fw-bold">
                        <i class="bi bi-gift me-1"></i> Redeem Reward
                    </div>
                    <div class="card-body d-flex flex-column">
                        @if (isEligibleToRedeem)
                        {
                            var carryover = _scannedCard.CurrentStamps - _scannedCard.TargetStamps;

                            <div class="alert alert-success small mb-3">
                                <strong>Eligible for Redemption!</strong><br />
                                Deducts <strong>@_scannedCard.TargetStamps stamps</strong> for
                                <em>@_scannedCard.RewardItem</em>.
                                @if (carryover > 0)
                                {
                                    <div class="mt-1">
                                        Carryover balance after redemption: <strong>@carryover stamp(s)</strong>.
                                    </div>
                                }
                            </div>

                            <div class="mb-3">
                                <label class="form-label small text-muted">Redemption Note (Optional)</label>
                                <input type="text"
                                       class="form-control"
                                       maxlength="200"
                                       placeholder="e.g., Counter 1 pickup"
                                       @bind="_redeemNotes" />
                            </div>

                            <button class="btn btn-success w-100 mt-auto"
                                    disabled="@_isProcessing"
                                    @onclick="HandleRedeemRewardAsync">
                                @if (_isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <span>Confirm Redemption (-@_scannedCard.TargetStamps Stamps)</span>
                            </button>
                        }
                        else
                        {
                            var needed = _scannedCard.TargetStamps - _scannedCard.CurrentStamps;
                            <div class="text-center my-auto py-4">
                                <i class="bi bi-lock display-6 text-muted mb-2"></i>
                                <p class="fw-semibold mb-1">Not Enough Stamps Yet</p>
                                <p class="text-muted small mb-0">
                                    Customer needs <strong>@needed more stamp(s)</strong> to unlock
                                    <em>@_scannedCard.RewardItem</em>.
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? _merchantUserId;
    private string _codeInput = string.Empty;
    private ScannedCardDetailsDto? _scannedCard;

    private decimal _spendAmount;
    private string? _earnNotes;
    private string? _redeemNotes;

    private bool _isLookingUp;
    private bool _isProcessing;
    private string? _statusMessage;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            _merchantUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LookupCardAsync();
        }
    }

    private async Task LookupCardAsync()
    {
        if (string.IsNullOrEmpty(_merchantUserId)) return;

        _isLookingUp = true;
        _statusMessage = null;

        try
        {
            var (card, error) = await IssueCommand.LookupCardAsync(_codeInput, _merchantUserId);
            if (card is not null)
            {
                _scannedCard = card;
                _isError = false;
            }
            else
            {
                _scannedCard = null;
                _isError = true;
                _statusMessage = error;
            }
        }
        finally
        {
            _isLookingUp = false;
        }
    }

    private async Task HandleIssueStampsAsync()
    {
        if (_scannedCard is null || string.IsNullOrEmpty(_merchantUserId)) return;

        _isProcessing = true;
        _statusMessage = null;

        try
        {
            var result = await IssueCommand.IssueAsync(
                _scannedCard.CardId,
                _spendAmount,
                _earnNotes,
                _merchantUserId);

            _isError = !result.Succeeded;
            _statusMessage = result.Message;

            if (result.Succeeded)
            {
                _spendAmount = 0;
                _earnNotes = null;
                await RefreshScannedCardAsync();
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task HandleRedeemRewardAsync()
    {
        if (_scannedCard is null || string.IsNullOrEmpty(_merchantUserId)) return;

        _isProcessing = true;
        _statusMessage = null;

        try
        {
            var result = await RedeemCommand.RedeemAsync(
                _scannedCard.CardId,
                _redeemNotes,
                _merchantUserId);

            _isError = !result.Succeeded;
            _statusMessage = result.Message;

            if (result.Succeeded)
            {
                _redeemNotes = null;
                await RefreshScannedCardAsync();
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task RefreshScannedCardAsync()
    {
        if (_scannedCard is null || string.IsNullOrEmpty(_merchantUserId)) return;
        var (refreshed, _) = await IssueCommand.LookupCardAsync(_scannedCard.CardId.ToString(), _merchantUserId);
        if (refreshed is not null)
        {
            _scannedCard = refreshed;
        }
    }

    private void ResetTerminal()
    {
        _codeInput = string.Empty;
        _scannedCard = null;
        _spendAmount = 0;
        _earnNotes = null;
        _redeemNotes = null;
        _statusMessage = null;
    }
}